diff --git a/arch/arm64/Kconfig b/arch/arm64/Kconfig
index df260dbab..3c2ba63f7 100644
--- a/arch/arm64/Kconfig
+++ b/arch/arm64/Kconfig
@@ -2441,6 +2441,51 @@ source "drivers/cpufreq/Kconfig"
 
 endmenu # "CPU Power Management"
 
+menu "dash device tuning"
+
+choice
+	prompt "-mtune target for the dash build"
+	default DASH_ARM64_TUNE_A720
+	help
+	  Selects the clang -mtune target used for codegen scheduling.
+	  This changes instruction scheduling/latency assumptions only:
+	  no ISA change, no ABI effect and no genksyms CRC impact.
+	  MT6991 (dash) has 4x Cortex-A720 (cpu0-3), 3x Cortex-A725
+	  (cpu4-6), and 1x Cortex-X925 (cpu7).  A720 is the conservative
+	  default because it is the largest homogeneous cluster and models
+	  the efficiency cores where sustained kernel work commonly runs.
+
+config DASH_ARM64_TUNE_A720
+	bool "Cortex-A720 (default: 4-core efficiency cluster on MT6991)"
+
+config DASH_ARM64_TUNE_A725
+	bool "Cortex-A725 (3-core performance cluster)"
+
+config DASH_ARM64_TUNE_X925
+	bool "Cortex-X925 (single prime core)"
+
+config DASH_ARM64_TUNE_NONE
+	bool "None (stock codegen, no -mtune)"
+
+endchoice
+
+config DASH_ARM64_TUNE
+	string
+	default "cortex-a720" if DASH_ARM64_TUNE_A720
+	default "cortex-a725" if DASH_ARM64_TUNE_A725
+	default "" if DASH_ARM64_TUNE_NONE
+
+config DASH_MLGO_REGALLOC
+	bool "Use the Clang MLGO register-allocation advisor"
+	default y
+	help
+	  Enables the AOT MLGO eviction advisor bundled with the pinned
+	  Android Clang toolchain. This affects code generation only; it
+	  needs no runtime profile and has no ABI or genksyms effect.
+
+endmenu # "dash device tuning"
+
+
 source "drivers/acpi/Kconfig"
 
 source "arch/arm64/kvm/Kconfig"
diff --git a/arch/arm64/Makefile b/arch/arm64/Makefile
index 2614ea63b..390d93d4d 100644
--- a/arch/arm64/Makefile
+++ b/arch/arm64/Makefile
@@ -42,6 +42,18 @@ KBUILD_CFLAGS	+= $(call cc-disable-warning, psabi)
 KBUILD_AFLAGS	+= $(compat_vdso)
 
 KBUILD_CFLAGS	+= $(call cc-option,-mabi=lp64)
+
+# dash: core-specific scheduling model (-mtune), see DASH_ARM64_TUNE choice.
+ifneq ($(CONFIG_DASH_ARM64_TUNE),)
+KBUILD_CFLAGS	+= -mtune=$(CONFIG_DASH_ARM64_TUNE)
+endif
+
+# Register allocation runs in clang for NoLTO and in LLD for Full LTO.
+ifeq ($(CONFIG_DASH_MLGO_REGALLOC),y)
+KBUILD_CFLAGS	+= -mllvm -regalloc-enable-advisor=release
+KBUILD_LDFLAGS	+= --mllvm=-regalloc-enable-advisor=release
+endif
+
 KBUILD_AFLAGS	+= $(call cc-option,-mabi=lp64)
 
 # Avoid generating .eh_frame* sections.
