diff --git a/arch/arm64/include/asm/mmu_context.h b/arch/arm64/include/asm/mmu_context.h
index a6fb32542..a65815a36 100644
--- a/arch/arm64/include/asm/mmu_context.h
+++ b/arch/arm64/include/asm/mmu_context.h
@@ -148,14 +148,24 @@ static inline void cpu_install_ttbr0(phys_addr_t ttbr0, unsigned long t0sz)
 	isb();
 }
 
+/*
+ * Declare this with an opaque object type: taking the address of a
+ * function-typed declaration makes clang emit a weak
+ * __kcfi_typeid_idmap_cpu_replace_ttbr1 in every translation unit that
+ * instantiates cpu_replace_ttbr1().  Full LTO merges those units and drops the
+ * duplicated weak absolute symbol, breaking the reference emitted by
+ * SYM_TYPED_FUNC_START() in proc.S.  The single type id is emitted from
+ * arch/arm64/mm/idmap_cfi.c instead.
+ */
+typedef void (ttbr_replace_func)(phys_addr_t);
+extern char idmap_cpu_replace_ttbr1[];
+
 /*
  * Atomically replaces the active TTBR1_EL1 PGD with a new VA-compatible PGD,
  * avoiding the possibility of conflicting TLB entries being allocated.
  */
 static inline void cpu_replace_ttbr1(pgd_t *pgdp, pgd_t *idmap)
 {
-	typedef void (ttbr_replace_func)(phys_addr_t);
-	extern ttbr_replace_func idmap_cpu_replace_ttbr1;
 	ttbr_replace_func *replace_phys;
 	unsigned long daif;
 
