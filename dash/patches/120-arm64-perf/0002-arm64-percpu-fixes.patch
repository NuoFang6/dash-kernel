diff --git a/arch/arm64/mm/idmap_cfi.c b/arch/arm64/mm/idmap_cfi.c
new file mode 100644
index 000000000..6a32a22fa
--- /dev/null
+++ b/arch/arm64/mm/idmap_cfi.c
@@ -0,0 +1,26 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * CFI type id for idmap_cpu_replace_ttbr1().
+ *
+ * SYM_TYPED_FUNC_START() in proc.S references
+ * __kcfi_typeid_idmap_cpu_replace_ttbr1, and the compiler only defines that
+ * symbol in translation units that take the function's address.  Declaring
+ * the function with its real prototype in mmu_context.h would make every
+ * instantiator of the cpu_replace_ttbr1() inline helper emit a weak absolute
+ * definition; Full LTO merges them and drops the duplicated weak symbol.
+ *
+ * Keep the address-taking in this single translation unit (which deliberately
+ * does not include mmu_context.h, so the opaque declaration there does not
+ * conflict) so the linker gets exactly one definition.
+ */
+
+#include <linux/compiler.h>
+#include <linux/types.h>
+#include <linux/cfi_types.h>
+
+#ifdef CONFIG_CFI_CLANG
+typedef void (ttbr_replace_func)(phys_addr_t);
+extern ttbr_replace_func idmap_cpu_replace_ttbr1;
+
+DEFINE_CFI_TYPE(idmap_cpu_replace_ttbr1_cfi_type, idmap_cpu_replace_ttbr1);
+#endif
