@@ -5592,6 +5594,10 @@ static bool should_abort_scan(struct lruvec *lruvec, struct scan_control *sc)
 #ifdef CONFIG_ANDROID_VENDOR_OEM_DATA
 	trace_android_vh_mglru_should_abort_scan(&sc->android_vendor_data1, &bypass);
