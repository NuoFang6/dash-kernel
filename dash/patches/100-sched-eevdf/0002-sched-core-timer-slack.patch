diff --git a/init/init_task.c b/init/init_task.c
index b0f8b0a10..0aab5ed65 100644
--- a/init/init_task.c
+++ b/init/init_task.c
@@ -131,6 +131,7 @@ struct task_struct init_task
 	INIT_CPU_TIMERS(init_task)
 	.pi_lock	= __RAW_SPIN_LOCK_UNLOCKED(init_task.pi_lock),
 	.timer_slack_ns = 50000, /* 50 usec default slack */
+	.default_timer_slack_ns = 50000,
 	.thread_pid	= &init_struct_pid,
 	.thread_group	= LIST_HEAD_INIT(init_task.thread_group),
 	.thread_node	= LIST_HEAD_INIT(init_signals.thread_head),
diff --git a/kernel/fork.c b/kernel/fork.c
index b909fa1cc..abf8ac57b 100644
--- a/kernel/fork.c
+++ b/kernel/fork.c
@@ -23,6 +23,7 @@
 #include <linux/sched/task.h>
 #include <linux/sched/task_stack.h>
 #include <linux/sched/cputime.h>
+#include <linux/sched/rt.h>
 #include <linux/seq_file.h>
 #include <linux/rtmutex.h>
 #include <linux/init.h>
@@ -2468,7 +2469,12 @@ __latent_entropy struct task_struct *copy_process(
 	memset(&p->rss_stat, 0, sizeof(p->rss_stat));
 #endif
 
-	p->default_timer_slack_ns = current->timer_slack_ns;
+	/* 6.6 has no rt_or_dl_task_policy(): check the policies directly. */
+	if (current->policy == SCHED_FIFO || current->policy == SCHED_RR ||
+	    current->policy == SCHED_DEADLINE)
+		p->default_timer_slack_ns = current->default_timer_slack_ns;
+	else
+		p->default_timer_slack_ns = current->timer_slack_ns;
 
 #ifdef CONFIG_PSI
 	p->psi_flags = 0;
diff --git a/kernel/sched/core.c b/kernel/sched/core.c
index 7284ca5e3..3753e4581 100644
--- a/kernel/sched/core.c
+++ b/kernel/sched/core.c
@@ -1776,6 +1776,7 @@ static inline void
 uclamp_update_active(struct task_struct *p)
 {
 	enum uclamp_id clamp_id;
+	unsigned int min_util, max_util;
 	struct rq_flags rf;
 	struct rq *rq;
 
@@ -1788,6 +1789,8 @@ uclamp_update_active(struct task_struct *p)
 	 * This is the same locking schema used by __set_cpus_allowed_ptr().
 	 */
 	rq = task_rq_lock(p, &rf);
+	min_util = uclamp_rq_get(rq, UCLAMP_MIN);
+	max_util = uclamp_rq_get(rq, UCLAMP_MAX);
 
 	/*
 	 * Setting the clamp bucket is serialized by task_rq_lock().
@@ -1798,6 +1801,13 @@ uclamp_update_active(struct task_struct *p)
 	for_each_clamp_id(clamp_id)
 		uclamp_rq_reinc_id(rq, p, clamp_id);
 
+	/* Notify the installed governor only when the rq's effective hints change. */
+	if (min_util != uclamp_rq_get(rq, UCLAMP_MIN) ||
+	    max_util != uclamp_rq_get(rq, UCLAMP_MAX)) {
+		update_rq_clock(rq);
+		cpufreq_update_util(rq, 0);
+	}
+
 	task_rq_unlock(rq, p, &rf);
 }
 
@@ -4892,6 +4902,7 @@ int sched_fork(unsigned long clone_flags, struct task_struct *p)
 			p->policy = SCHED_NORMAL;
 			p->static_prio = NICE_TO_PRIO(0);
 			p->rt_priority = 0;
+			p->timer_slack_ns = p->default_timer_slack_ns;
 		} else if (PRIO_TO_NICE(p->static_prio) < 0)
 			p->static_prio = NICE_TO_PRIO(0);
 
