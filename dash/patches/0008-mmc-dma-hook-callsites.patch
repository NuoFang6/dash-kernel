diff --git a/drivers/dma-buf/heaps/system_heap.c b/drivers/dma-buf/heaps/system_heap.c
index 78fcce7a1..38d11cba8 100644
--- a/drivers/dma-buf/heaps/system_heap.c
+++ b/drivers/dma-buf/heaps/system_heap.c
@@ -11,6 +11,7 @@
  */
 
 #include <linux/dma-buf.h>
+#include <trace/hooks/dmabuf.h>
 #include <linux/dma-mapping.h>
 #include <linux/dma-heap.h>
 #include <linux/err.h>
@@ -370,13 +371,22 @@ static struct dma_buf *system_heap_do_allocate(struct dma_heap *heap,
 	struct list_head pages;
 	struct page *page, *tmp_page;
 	int i, ret = -ENOMEM;
+	unsigned long long stime = 0;
 
-	if (len / PAGE_SIZE > totalram_pages())
+	trace_android_vh_dma_heap_buffer_alloc_lat_start(&stime);
+
+	if (len / PAGE_SIZE > totalram_pages()) {
+		trace_android_vh_dma_heap_buffer_alloc_lat_end(stime, len,
+							       ERR_PTR(-ENOMEM));
 		return ERR_PTR(-ENOMEM);
+	}
 
 	buffer = kzalloc(sizeof(*buffer), GFP_KERNEL);
-	if (!buffer)
+	if (!buffer) {
+		trace_android_vh_dma_heap_buffer_alloc_lat_end(stime, len,
+							       ERR_PTR(-ENOMEM));
 		return ERR_PTR(-ENOMEM);
+	}
 
 	INIT_LIST_HEAD(&buffer->attachments);
 	mutex_init(&buffer->lock);
@@ -440,6 +450,7 @@ static struct dma_buf *system_heap_do_allocate(struct dma_heap *heap,
 		dma_unmap_sgtable(dma_heap_get_dev(heap), table, DMA_BIDIRECTIONAL, 0);
 	}
 
+	trace_android_vh_dma_heap_buffer_alloc_lat_end(stime, len, dmabuf);
 	return dmabuf;
 
 free_pages:
@@ -454,6 +465,8 @@ static struct dma_buf *system_heap_do_allocate(struct dma_heap *heap,
 		__free_pages(page, compound_order(page));
 	kfree(buffer);
 
+	trace_android_vh_dma_heap_buffer_alloc_lat_end(stime, len,
+						       ERR_PTR(ret));
 	return ERR_PTR(ret);
 }
 
diff --git a/drivers/mmc/core/block.c b/drivers/mmc/core/block.c
index 1f7bbc9dc..46ec35207 100644
--- a/drivers/mmc/core/block.c
+++ b/drivers/mmc/core/block.c
@@ -1032,8 +1032,10 @@ static int mmc_blk_reset(struct mmc_blk_data *md, struct mmc_host *host,
 	int err;
 	struct mmc_blk_data *main_md = dev_get_drvdata(&host->card->dev);
 
-	if (md->reset_done & type)
+	if (md->reset_done & type) {
+		trace_android_vh_mmc_blk_reset(host, -EEXIST);
 		return -EEXIST;
+	}
 
 	md->reset_done |= type;
 	err = mmc_hw_reset(host->card);
@@ -1043,15 +1045,20 @@ static int mmc_blk_reset(struct mmc_blk_data *md, struct mmc_host *host,
 	 * in that case.
 	 */
 	main_md->part_curr = err ? MMC_BLK_PART_INVALID : main_md->part_type;
-	if (err)
+	if (err) {
+		trace_android_vh_mmc_blk_reset(host, err);
 		return err;
+	}
 	/* Ensure we switch back to the correct partition */
-	if (mmc_blk_part_switch(host->card, md->part_type))
+	if (mmc_blk_part_switch(host->card, md->part_type)) {
 		/*
 		 * We have failed to get back into the correct
 		 * partition, so we need to abort the whole request.
 		 */
+		trace_android_vh_mmc_blk_reset(host, -ENODEV);
 		return -ENODEV;
+	}
+	trace_android_vh_mmc_blk_reset(host, 0);
 	return 0;
 }
 
