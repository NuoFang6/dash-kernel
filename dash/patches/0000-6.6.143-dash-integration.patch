+			sbi->hi.main.start, sbi->hi.main.start_segno,
+			sbi->hi.main.start_secno, sbi->hi.main.len,
+			sbi->hi.main.free, sbi->hi.main.free_segs,
+			sbi->hi.main.dirty_segs, sbi->hi.main.gc_count,
+			sbi->hi.ext.start, sbi->hi.ext.start_segno,
+			sbi->hi.ext.start_secno, sbi->hi.ext.len,
+			sbi->hi.ext.free, sbi->hi.ext.free_segs,
