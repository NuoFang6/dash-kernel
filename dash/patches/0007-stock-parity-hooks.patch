diff --git a/include/trace/events/lz4.h b/include/trace/events/lz4.h
new file mode 100644
index 000000000..16cd8db32
--- /dev/null
+++ b/include/trace/events/lz4.h
@@ -0,0 +1,64 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+#undef TRACE_SYSTEM
+#define TRACE_SYSTEM lz4_decompress
+#undef TRACE_INCLUDE_PATH
+#define TRACE_INCLUDE_PATH trace/events
+#undef TRACE_INCLUDE_FILE
+#define TRACE_INCLUDE_FILE lz4
+
+#if !defined(_TRACE_EVENTS_LZ4_H) || defined(TRACE_HEADER_MULTI_READ)
+#define _TRACE_EVENTS_LZ4_H
+
+#include <linux/tracepoint.h>
+
+TRACE_EVENT(lz4_decompress_start,
+
+	TP_PROTO(void *in, int inputsize, int outputsize, int bypass),
+
+	TP_ARGS(in, inputsize, outputsize, bypass),
+
+	TP_STRUCT__entry(
+		__field(int, inputsize)
+		__field(int, outputsize)
+		__field(int, bypass)
+	),
+
+	TP_fast_assign(
+		__entry->inputsize = inputsize;
+		__entry->outputsize = outputsize;
+		__entry->bypass = bypass;
+	),
+
+	TP_printk("inputsize=%d outputsize=%d bypass=%d",
+		  __entry->inputsize, __entry->outputsize, __entry->bypass)
+);
+
+TRACE_EVENT(lz4_decompress_end,
+
+	TP_PROTO(void *in, int inputsize, int outputsize, int ret, int bypass),
+
+	TP_ARGS(in, inputsize, outputsize, ret, bypass),
+
+	TP_STRUCT__entry(
+		__field(int, inputsize)
+		__field(int, outputsize)
+		__field(int, ret)
+		__field(int, bypass)
+	),
+
+	TP_fast_assign(
+		__entry->inputsize = inputsize;
+		__entry->outputsize = outputsize;
+		__entry->ret = ret;
+		__entry->bypass = bypass;
+	),
+
+	TP_printk("inputsize=%d outputsize=%d ret=%d bypass=%d",
+		  __entry->inputsize, __entry->outputsize, __entry->ret,
+		  __entry->bypass)
+);
+
+#endif /* _TRACE_EVENTS_LZ4_H */
+
+/* This part must be outside protection */
+#include <trace/define_trace.h>
