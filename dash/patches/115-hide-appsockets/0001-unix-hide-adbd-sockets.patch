+	.bind =		susfs_unix_bind,
+	.connect =	susfs_unix_dgram_connect,
+#else
 	.bind =		unix_bind,
 	.connect =	unix_dgram_connect,
+#endif
 	.socketpair =	unix_socketpair,
 	.accept =	sock_no_accept,
 	.getname =	unix_getname,
@@ -926,8 +1004,13 @@ static const struct proto_ops unix_seqpacket_ops = {
 	.family =	PF_UNIX,
 	.owner =	THIS_MODULE,
 	.release =	unix_release,
+#ifdef CONFIG_KSU_SUSFS
+	.bind =		susfs_unix_bind,
+	.connect =	susfs_unix_stream_connect,
+#else
 	.bind =		unix_bind,
 	.connect =	unix_stream_connect,
+#endif
 	.socketpair =	unix_socketpair,
 	.accept =	unix_accept,
 	.getname =	unix_getname,
@@ -3363,6 +3446,22 @@ static int unix_seq_show(struct seq_file *seq, void *v)
 		struct sock *s = v;
 		struct unix_sock *u = unix_sk(s);
 		unix_state_lock(s);
+#ifdef CONFIG_KSU_SUSFS
+		if (u->addr && susfs_is_current_app_uid()) {
+			int path_len = u->addr->len - offsetof(struct sockaddr_un, sun_path);
+			const char *sp = u->addr->name->sun_path;
+			if (path_len > 0) {
+				if (!sp[0] && path_len >= 13 && !memcmp(sp + 1, "jdwp-control", 12)) {
+					unix_state_unlock(s);
+					return 0;
+				}
+				if (sp[0] && path_len >= 16 && !memcmp(sp, "/dev/socket/adbd", 16)) {
+					unix_state_unlock(s);
+					return 0;
+				}
+			}
+		}
+#endif
 
 		seq_printf(seq, "%pK: %08X %08X %08X %04X %02X %5lu",
 			s,
