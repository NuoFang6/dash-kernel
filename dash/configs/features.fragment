# dash kernel 功能开关 fragment —— **唯一权威的功能配置输入**(configure.sh
# 会把它合并进 out/<dev>/.config 后跑 olddefconfig;"# CONFIG_X is not set"
# 与 "CONFIG_X=..." 都是生效指令,不是注释)。required 断言在
# scripts/configure.sh,防止开关被静默丢弃。
CONFIG_KSU=y
CONFIG_KSU_MULTI_MANAGER_SUPPORT=y
# CONFIG_KSU_TRACEPOINT_HOOK is not set
# CONFIG_KSU_MANUAL_HOOK is not set
CONFIG_KSU_SUSFS=y
# susfs4ksu f98f082 wraps the priority-uid filter in this gate and ships no
# Kconfig entry; apply-patches.sh injects one (fs/Kconfig).  Keep =y to match
# the previous pin where the filter compiled unconditionally.
CONFIG_KSU_SUSFS_PRIORITY_UID_FILTER=y

CONFIG_VENDOR_KO_COMPAT=y
CONFIG_UDMABUF=y
CONFIG_MEMFD_ASHMEM_SHIM=y

CONFIG_XIAOMI_ENHANCED_IOSTAT=y
CONFIG_XIAOMI_EROFS_IOSTAT=y
CONFIG_F2FS_VIP_FILE=y
CONFIG_F2FS_FS_HYBRID_UFS=y
CONFIG_BLOCK_HYBRID_UFS=y

CONFIG_GKI_DYNAMIC_TASK_STRUCT_SIZE=y
CONFIG_GKI_TASK_STRUCT_VENDOR_SIZE_MAX=1024
CONFIG_CRYPTO_LZ4KD=y
# LTO 是构建模式而非功能开关：configure.sh 按 FAST=1 → NoLTO、
# 最终生产构建 → Full LTO 选择，不在本 fragment 固定。

# mihomo Android runtime support (2026-10-30)
# TProxy/redir scripts use "-m addrtype"; stock GKI disables this match.
CONFIG_NETFILTER_XT_MATCH_ADDRTYPE=y
# IPv6 REDIRECT/DNAT for REDIRECT-mode tests and DNS hijack.
CONFIG_IP6_NF_NAT=y
CONFIG_IP6_NF_TARGET_MASQUERADE=y
# CONFIG_MPTCP is intentionally left disabled: enabling MPTCP (v6.6.143,
# IPv6+diag) made dash hang before Android userspace started. mihomo runs with
# "inbound-mptcp: false"; see docs/kernel/MIHOMO_ANDROID.md.

# DroidSpaces container runtime support (2026-11-21, official GKI fragment).
# SYSVIPC/IPC_NS fields land in ANDROID_KABI padding via patches/090-droidspaces
# (sysvsem -> slot 6, sysvshm -> slots 7+8), so task_struct offsets and the
# vendor .ko ABI stay stock.  DEVTMPFS_MOUNT stays off: Android init mounts
# /dev itself.
CONFIG_SYSVIPC=y
CONFIG_POSIX_MQUEUE=y
CONFIG_IPC_NS=y
CONFIG_PID_NS=y
CONFIG_DEVTMPFS=y
# CONFIG_DEVTMPFS_MOUNT is not set
CONFIG_USER_NS=y
CONFIG_TMPFS_XATTR=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_MACVLAN=y
# UFW / Fail2ban inside containers.  REJECT is covered by the legacy
# IP_NF_TARGET_REJECT / IP6_NF_TARGET_REJECT (stock y); the nft variant
# NETFILTER_XT_TARGET_REJECT does not exist on 6.6.
CONFIG_IP_SET=y
CONFIG_IP_SET_HASH_IP=y
CONFIG_IP_SET_HASH_NET=y
CONFIG_NETFILTER_XT_SET=y
CONFIG_NETFILTER_XT_TARGET_LOG=y
CONFIG_NETFILTER_XT_MATCH_RECENT=y
# CONFIG_CFS_BANDWIDTH / CONFIG_CGROUP_PIDS stay off on purpose: they resize
# scheduler/cgroup structs and would break every prebuilt vendor module
# (--cpus / --pids-limit are skipped with a warning by droidspaces).

# === WildKernels/GKID/EVONIX 特性调查落地(2026-11-21,FEATURES_SURVEY.md)===

# 网络:BBRv3(110-net-bbrv3;DEFAULT_TCP_CONG 仍 cubic)
CONFIG_TCP_CONG_BBR3=y
# 网络:额外拥塞控制算法(默认仍 cubic;sched_setdefault 运行时切换)
CONFIG_TCP_CONG_WESTWOOD=y
CONFIG_TCP_CONG_BIC=y
CONFIG_TCP_CONG_HTCP=y
# 网络:活动队列管理 qdisc(不设默认,按需 tc qdisc add)
CONFIG_NET_SCH_CAKE=y
CONFIG_NET_SCH_PIE=y
CONFIG_NET_SCH_FQ_PIE=y
# 网络:IP Set 全家桶(DroidSpaces 防火墙;HASH_IP/HASH_NET 此前已有)
CONFIG_IP_SET_BITMAP_IP=y
CONFIG_IP_SET_BITMAP_IPMAC=y
CONFIG_IP_SET_BITMAP_PORT=y
CONFIG_IP_SET_HASH_IPMAC=y
CONFIG_IP_SET_HASH_IPMARK=y
CONFIG_IP_SET_HASH_IPPORT=y
CONFIG_IP_SET_HASH_IPPORTIP=y
CONFIG_IP_SET_HASH_IPPORTNET=y
CONFIG_IP_SET_HASH_MAC=y
CONFIG_IP_SET_HASH_NETIFACE=y
CONFIG_IP_SET_HASH_NETNET=y
CONFIG_IP_SET_HASH_NETPORT=y
CONFIG_IP_SET_HASH_NETPORTNET=y
CONFIG_IP_SET_LIST_SET=y
# 电源/内存:RCU lazy 回调批量(RCU_NOCB_CPU=y 已满足依赖;异常时
# rcutree.enable_rcu_lazy=0 回退)
CONFIG_RCU_LAZY=y
# 电源:power-efficient workqueue(workqueue.power_efficient=0 可回退)
CONFIG_WQ_POWER_EFFICIENT_DEFAULT=y
# 内存/调试加固:2026-11-24 机主要求生产构建关闭这些调试与加固开销
# (UBSan 检查与 trap、分配清零、KFENCE 采样、freelist 混淆、SLUB debug)。
# 代价:丢失对应运行期检测/加固;收益:去掉热路径分支与额外的内存初始化。
# CONFIG_KFENCE is not set
# CONFIG_UBSAN is not set
# CONFIG_UBSAN_TRAP is not set
# CONFIG_INIT_ON_ALLOC_DEFAULT_ON is not set
# CONFIG_SLAB_FREELIST_HARDENED is not set
# CONFIG_SLUB_DEBUG is not set
# NT 同步原语模拟(/dev/ntsync,Wine 系;主线 v6.14 驱动的 6.6 backport)
CONFIG_NTSYNC=y
# ADIOS I/O 调度器(EVONIX 同款 6.6 适配;设为默认,附加模块在已是 adios 时跳过)
CONFIG_MQ_IOSCHED_ADIOS=y
# ADIOS 设为默认调度器；附加模块检测到已是 adios 时不再重复写
CONFIG_MQ_IOSCHED_DEFAULT_ADIOS=y
# EVONIX 的前台同步读优先级保护(仅 ADIOS 生效;上游 default y)
CONFIG_EVONIX_IO_PRIO=y
# zram 默认压缩算法：lz4kd（vendor init 仍会写 lz4，附加模块会恢复 lz4kd）
CONFIG_ZRAM_DEF_COMP_LZ4KD=y
# 网络默认：BBR3 拥塞控制 + fq 队列（附加模块在已是默认时跳过）
CONFIG_DEFAULT_BBR3=y
CONFIG_NET_SCH_DEFAULT=y
CONFIG_DEFAULT_FQ=y
# Baseband Guard LSM(通用 Android 分区防格式化;boot/recovery 不保护,
# 保持可刷;LSM 链末尾追加,顺序与 EVONIX 一致)
CONFIG_BBG=y
# CONFIG_BBG_BLOCK_BOOT is not set
# CONFIG_BBG_BLOCK_RECOVERY is not set
CONFIG_LSM="landlock,lockdown,yama,loadpin,safesetid,selinux,smack,tomoyo,apparmor,bpf,baseband_guard"
# LLVM AutoFDO 构建支持(无 profile 时仅增加 fs-discriminator 元数据;
# 采集流程见 docs/kernel/README.md "AutoFDO")
CONFIG_AUTOFDO_CLANG=y
# LLVM MLGO AOT register-allocation advisor; no runtime profile required.
CONFIG_DASH_MLGO_REGALLOC=y
# dash -mtune 调度模型(实机 MIDR:4x A720 + 3x A725 + 1x X925;
# 默认选最大同构簇/能效簇 A720 的保守模型,choice 也可选 A725/X925/无)
CONFIG_DASH_ARM64_TUNE_A720=y
# 版本串不含自动 -dirty/+gHASH 后缀(KBUILD_BUILD_*,见 build.sh)
# CONFIG_LOCALVERSION_AUTO is not set

# RCU lazy 默认启用(异常时用 rcutree.enable_rcu_lazy=0 回退)
# CONFIG_RCU_LAZY_DEFAULT_OFF is not set

# ── 2026-11-24 用户请求的运行时能力（仅 configure 验证，未重编） ──
# Landlock LSM：进程自沙箱；stock 关闭，LANDLOCK 已在 LSM 链首位
CONFIG_SECURITY_LANDLOCK=y
# rseq：保持关闭。arm64 HAVE_RSEQ 可用，但 CONFIG_RSEQ 会在 task_struct 中
# 插入 rseq/rseq_len/rseq_sig/rseq_event_mask，并连带打开 CONFIG_SCHED_MM_CID
# （def_bool y，depends on RSEQ），使 task_struct 4800B→4864B、
# android_vendor_data1 偏移 3008→3064。MTK 预编译厂商模块（mtk_task /
# node_cache 等，启动早期即有 __get_mi_task_struct）按 stock 偏移访问 vendor
# data，偏移漂移会破坏其读写，实测启动花屏后重启（2026-11-24）。
# CONFIG_RSEQ is not set
# CONFIG_SCHED_MM_CID is not set
# 大页：HugeTLB 文件系统（THP 已由 stock 以 madvise 启用）。
# 注意：CGROUP_HUGETLB 必须保持关闭 —— 每个额外 cgroup 控制器都会改变
# enum cgroup_subsys_id 的编号（devices 插在 memory 后、hugetlb 在 net_prio
# 后），原厂 7 个控制器是 cpuset0/cpu1/cpuacct2/io3/memory4/freezer5/net_prio6；
# 打开后 freezer 5→6、net_prio 6→7，厂商预编译模块用 stock 常量索引
# task_css(task, freezer_cgrp_id) 内联访问会拿到错误的子系统指针。
CONFIG_HUGETLBFS=y
# CONFIG_CGROUP_HUGETLB is not set
# Docker/容器补齐：device cgroup。同样会改变子系统编号（freezer/net_prio
# 各后移一位），故保持关闭；Docker 设备限制改用宿主机 BPF 方案。
# CONFIG_CGROUP_DEVICE is not set
# 注明：不引入 nftables；Docker 使用 iptables-legacy/xtables 路径。
# VXLAN 仅 Docker overlay 网络使用，未创建接口时零开销。
CONFIG_VXLAN=y
# DroidVM：vhost-net 加速（KVM / MTK_GZVM / TUN 已具备）
CONFIG_VHOST_NET=y
